FROM paradedb/paradedb:0.22.0-pg18

#  Locale & timezone 
ENV LANG=en_US.utf8 \
    TZ=UTC

#  Copy init scripts 
# Postgres runs every *.sql and *.sh file in this directory on first start,
# in alphabetical order. Prefixing with numbers controls execution order.
COPY init /docker-entrypoint-initdb.d/

#  Healthcheck 
# Used by docker-compose depends_on condition: service_healthy
HEALTHCHECK --interval=5s --timeout=5s --retries=10 \
    CMD pg_isready -U "${POSTGRES_USER:-scholarrag}" -d "${POSTGRES_DB:-scholarrag}"

EXPOSE 5432
