# ScholarRAG Configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Embedding Backend
# ---------------------------------------------------------------------------
# Options: vllm, ollama, openai, cohere, gemini
EMBED_BACKEND=vllm

# vLLM embedding settings
VLLM_EMBED_MODEL=intfloat/e5-mistral-7b-instruct

# Ollama embedding settings
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_URL=http://localhost:11434

# OpenAI embedding settings
OPENAI_EMBED_MODEL=text-embedding-3-large

# Cohere embedding settings
COHERE_EMBED_MODEL=embed-english-v3.0

# Gemini embedding settings
GEMINI_EMBED_MODEL=gemini-embedding-001

# Embedding batch size and dimension
EMBED_BATCH_SIZE=64
EMBED_DIM=1024

# ---------------------------------------------------------------------------
# Reranker Backend
# ---------------------------------------------------------------------------
# Options: vllm, cohere, gemini, none
RERANKER_BACKEND=vllm

# vLLM reranker settings
VLLM_RERANKER_MODEL=BAAI/bge-reranker-v2-minimum

# Cohere reranker settings
COHERE_RERANKER_MODEL=rerank-v4.0-fast

# Gemini reranker settings (uses Gemini embeddings for semantic similarity)
GEMINI_RERANKER_MODEL=gemini-embedding-001

# Reranking parameters
RERANKER_TOP_K=8
RERANKER_INITIAL_K=50

# ---------------------------------------------------------------------------
# LLM Backend (for generation)
# ---------------------------------------------------------------------------
# Options: ollama, vllm, openai, cohere, gemini
LLM_BACKEND=ollama

# Ollama LLM settings
OLLAMA_MODEL=llama3
OLLAMA_LLM_URL=http://localhost:11434

# vLLM LLM settings
VLLM_URL=http://localhost:8000
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# OpenAI LLM settings
OPENAI_MODEL=gpt-4o-mini

# Cohere LLM settings
COHERE_MODEL=command-a-03-2025

# Gemini LLM settings
GEMINI_MODEL=gemini-1.5-flash

# LLM parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# API Keys (required for hosted backends)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/scholarrag
PGVECTOR_TABLE=chunks

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
BM25_TOP_K=50
DENSE_TOP_K=50
RRF_K=60

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Agentic RAG & Evaluation
# ---------------------------------------------------------------------------
USE_HYDE=true
GROUNDING_THRESHOLD=0.9
MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Evaluation LLM Backend
# ---------------------------------------------------------------------------
# Options: vllm, ollama, openai, gemini
EVAL_BACKEND=ollama

# Ollama evaluation settings
OLLAMA_EVAL_MODEL=llama3
OLLAMA_EVAL_URL=http://localhost:11434

# vLLM evaluation settings
VLLM_EVAL_URL=http://localhost:8000
VLLM_EVAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# OpenAI evaluation settings
OPENAI_EVAL_MODEL=gpt-4o-mini

# Google Gemini evaluation settings
GEMINI_EVAL_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Evaluation Paths
# ---------------------------------------------------------------------------
EVAL_TEST_SET_PATH=eval/test_set.json
EVAL_OUTPUT_PATH=eval/results.json
