# ScholarRAG Configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Model Backend (Unified for embedding, reranking, LLM, and evaluation)
# ---------------------------------------------------------------------------
# Options: qwen, openai, gemini
MODEL_BACKEND=qwen

# ---------------------------------------------------------------------------
# Qwen Settings (local, high-throughput)
# ---------------------------------------------------------------------------
QWEN_URL=http://localhost:8000
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
QWEN_EMBED_MODEL=Qwen/Qwen2.5-Embed-7B
QWEN_RERANKER_MODEL=Qwen/Qwen2.5-Reranker-7B
QWEN_EVAL_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------------------------
# OpenAI Settings (hosted)
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# OpenAI embedding model: text-embedding-3-large or text-embedding-3-small
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EVAL_MODEL=gpt-4o-mini
# Note: OpenAI reranking uses embeddings + cosine similarity (not a dedicated reranker model)
OPENAI_RERANKER_MODEL=text-embedding-3-large

# ---------------------------------------------------------------------------
# Gemini Settings (hosted)
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini embedding model: gemini-embedding-001 or gemini-embedding-002
GEMINI_EMBED_MODEL=gemini-embedding-001
# Note: 1536 dimensions is hardcoded (preserves compatibility between both models)
# Note: Gemini reranking uses embeddings + cosine similarity (not a dedicated reranker model)
GEMINI_RERANKER_MODEL=gemini-embedding-001
GEMINI_EVAL_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# API Keys (required for hosted backends: openai, gemini)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# LLM Parameters
# ---------------------------------------------------------------------------
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Embedding Parameters
# ---------------------------------------------------------------------------
EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Reranking Parameters
# ---------------------------------------------------------------------------
RERANKER_TOP_K=8
RERANKER_INITIAL_K=50

# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/scholarrag
PGVECTOR_TABLE=chunks

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
BM25_TOP_K=50
DENSE_TOP_K=50
RRF_K=60

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
DEBUG=true

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Options: local, s3
FILE_UPLOAD_PROVIDER=local

DOWNLOAD_DIR=downloads

# S3 / MinIO Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scholar-rag
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Agentic RAG & Evaluation
# ---------------------------------------------------------------------------
USE_HYDE=true
GROUNDING_THRESHOLD=0.9
MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
EVAL_TEST_SET_PATH=eval/test_set.json
EVAL_OUTPUT_PATH=eval/results.json

#Langfuse
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0