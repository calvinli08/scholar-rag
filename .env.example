#  ScholarRAG — environment configuration 
# Copy this file to .env and fill in the values you need.
# Local backends (hf, ollama, vllm) require no API keys.
# Hosted backends (openai, cohere, anthropic) require the relevant key.
# All local backends are the default — the system runs fully offline out of the box.

#  Embedding backend 
# Options: hf | ollama | openai | cohere
EMBED_BACKEND=hf

# HuggingFace (local) — any Sentence Transformers compatible model
HF_EMBED_MODEL=BAAI/bge-large-en-v1.5

# Ollama (local) — model must be pulled first: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_URL=http://localhost:11434

# OpenAI (hosted)
OPENAI_EMBED_MODEL=text-embedding-3-large

# Cohere (hosted)
COHERE_EMBED_MODEL=embed-english-v3.0

# Dimension of the embedding vectors — must match your chosen model
EMBED_DIM=1024
EMBED_BATCH_SIZE=64

#  Reranker backend 
# Options: hf | cohere | none
RERANKER_BACKEND=hf

# HuggingFace (local) — any cross-encoder compatible model
HF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cohere (hosted)
COHERE_RERANKER_MODEL=rerank-english-v3.0

# How many candidates to fetch before reranking, and how many to keep after
RERANKER_INITIAL_K=50
RERANKER_TOP_K=8

#  LLM backend 
# Options: ollama | hf | vllm | openai | anthropic | cohere
LLM_BACKEND=ollama

# Ollama (local) — model must be pulled first: ollama pull llama3
OLLAMA_MODEL=llama3
OLLAMA_LLM_URL=http://localhost:11434

# HuggingFace (local) — any AutoModelForCausalLM compatible model
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# vLLM (local server) — start with: python -m vllm.entrypoints.openai.api_server
VLLM_URL=http://localhost:8000
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# OpenAI (hosted)
OPENAI_MODEL=gpt-4o-mini

# Anthropic (hosted)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

COHERE_MODEL=command-a-03-2025

# Generation parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

#  API keys 
# Only required for the hosted backends you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

#  Vector store 
DATABASE_URL=postgresql://localhost:5432/scholarrag
PGVECTOR_TABLE=chunks

#  Retrieval parameters 
DENSE_TOP_K=50
BM25_TOP_K=50
RRF_K=60

#  Chunking parameters 
CHUNK_SIZE=512
CHUNK_OVERLAP=128

#  Eval 
EVAL_TEST_SET_PATH=eval/test_set.json
EVAL_OUTPUT_PATH=eval/results.json

#  App 
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info

#  Ingestion 
UPLOAD_DIR=./uploads

#  Agentic RAG & Evaluation 
# HyDE (Hypothetical Document Embeddings)
USE_HYDE=true

# Grounding evaluation (DeepEval Faithfulness)
GROUNDING_THRESHOLD=0.9
MAX_RETRIES=2

#  Eval 
EVAL_TEST_SET_PATH=eval/test_set.json
EVAL_OUTPUT_PATH=eval/results.json
